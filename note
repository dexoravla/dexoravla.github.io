<script>
  function copyBibTeX() {
    const bibtexCode = document.getElementById('bibtex-code').textContent;
    navigator.clipboard.writeText(bibtexCode).then(function() {
      alert('BibTeX copied to clipboard!');
    }, function(err) {
      alert('Failed to copy BibTeX.');
    });
  }
</script>

